{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "StreamBuild",
  "description": "Declarative streaming data pipelines for ClickHouse.",
  "colors": {
    "primary": "#087E8B",
    "light": "#0EA5A8",
    "dark": "#0D9488"
  },
  "logo": {
    "light": "/streambuild_logo_light_cropped.png",
    "dark": "/streambuild_logo_dark_cropped.png"
  },
  "favicon": "/streambuild_favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "concepts/project-configuration",
          "concepts/authentication-and-access",
          "concepts/access-control",
          "concepts/sensors",
          "concepts/providers",
          "concepts/pipelines",
          "concepts/models",
          "concepts/direct-mode",
          "concepts/deployments",
          "concepts/destructive-operations",
          "concepts/replay-lineage",
          "concepts/architecture",
          "concepts/testing",
          "concepts/macros",
          "concepts/audits"
        ]
      },
      {
        "group": "Development UI",
        "pages": [
          "ui/overview",
          "ui/pipelines",
          "ui/warehouse-health",
          "ui/sources",
          "ui/topics",
          "ui/messages",
          "ui/plans",
          "ui/runs",
          "ui/quality"
        ]
      },
      {
        "group": "CLI Reference",
        "pages": [
          "cli/discover",
          "cli/compile",
          "cli/plan",
          "cli/build",
          "cli/dev",
          "cli/audit",
          "cli/deployment",
          "cli/test",
          "cli/doctor",
          "cli/repair",
          "cli/reconcile",
          "cli/janitor",
          "cli/destruction"
        ]
      },
      {
        "group": "Examples",
        "pages": [
          "examples/orders-demo"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/ui/sources-and-messages",
      "destination": "/ui/sources"
    },
    {
      "source": "/ui/plans-and-runs",
      "destination": "/ui/plans"
    }
  ],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/sqlstack-io/streambuild",
        "type": "github"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sqlstack-io/streambuild"
    }
  }
}
